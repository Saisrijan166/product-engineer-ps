# Normalise to LF in the repository, and let Git pick the right ending on checkout.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses them. mvnw.cmd is the Maven
# Wrapper entry point for a reviewer on Windows, so this is not cosmetic.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must keep LF even when checked out on Windows: a CRLF shebang makes the
# kernel look for an interpreter whose name ends in \r.
*.sh text eol=lf
mvnw  text eol=lf

# Binary: never touch, never diff.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
