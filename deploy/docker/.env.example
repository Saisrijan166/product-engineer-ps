# Copy to .env and edit if any of these ports are taken on your machine.
#
#     cp .env.example .env
#
# Every value here has a working default in docker-compose.yml, so .env is optional.
# No secrets belong in this file: the database credentials below are for a throwaway
# local container and are not used anywhere else.

# --- host ports -------------------------------------------------------------
# Everything binds to 127.0.0.1 only.

INGEST_PORT=8080
DELIVERY_PORT=8081
RECEIVER_PORT=8082
ADMINER_PORT=8090

# 55433 rather than 5432, so this never fights a PostgreSQL already installed on the host.
POSTGRES_PORT=55433

# --- credentials ------------------------------------------------------------
# Throwaway. The container is created with these on first start.

POSTGRES_USER=webhook
POSTGRES_PASSWORD=webhook

# --- behaviour --------------------------------------------------------------
# demo    1s -> 2s -> 4s -> 8s   backoff, so a full retry cycle fits in a video
# default 5s -> 25s -> 125s -> 600s

SPRING_PROFILES_ACTIVE=demo
