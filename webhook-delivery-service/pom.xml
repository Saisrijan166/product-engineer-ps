<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.caygnus.webhook</groupId>
        <artifactId>webhook-retry-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>webhook-delivery-service</artifactId>
    <name>webhook-delivery-service</name>
    <description>Claims due deliveries, performs the HTTP attempt, classifies the outcome, and schedules retries.</description>

    <dependencies>
        <dependency>
            <groupId>com.caygnus.webhook</groupId>
            <artifactId>webhook-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Scrape endpoint only; the meters themselves are Micrometer, already on the classpath. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            RestClient's default JDK request factory has no connection pool and no per-route cap,
            so one slow receiver could tie up every worker. HttpClient 5 gives both, plus a
            separate connect timeout and the ability to turn OFF its own retrying. This engine
            owns retries, and a hidden extra attempt would silently break the attempt bound.
        -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!--
            The acceptance tests drive the real receiver rather than a mock, so that what they
            prove about headers and status handling is what a reviewer will see in the demo.
        -->
        <dependency>
            <groupId>com.caygnus.webhook</groupId>
            <artifactId>webhook-test-receiver</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers, never H2: the behaviour under test here IS PostgreSQL behaviour.
            FOR UPDATE SKIP LOCKED, ON CONFLICT DO NOTHING and partial indexes either do not
            exist on an embedded database or behave differently, so a green H2 suite would be
            evidence of nothing.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Layered jar: Docker rebuilds only the application layer (ARCHITECTURE.md 14). -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
